# KLiXO Coach — environment (one deployment = one centre)

# Google Sheet that backs THIS centre (the invisible DB).
SHEET_ID=

# Service-account credentials with editor access to the Sheet.
# Paste the FULL service-account JSON as a single-line string.
# On Vercel: add as an Encrypted env var. Never commit the real value.
GOOGLE_SERVICE_ACCOUNT_JSON=

# Centre's local timezone. CRITICAL: "today"/day-of-week is computed here,
# never the server's UTC clock. (See PLAN.md §11.)
CENTER_TZ=Asia/Kolkata

# Google OAuth client — lets the centre owner connect their own Drive for file
# storage (uploads, generated PDFs). See docs/google-integration.md.
# The OAuth app must be published "In production" with the drive.file scope.
GOOGLE_OAUTH_CLIENT_ID=
GOOGLE_OAUTH_CLIENT_SECRET=
GOOGLE_OAUTH_REDIRECT_URI=https://your-domain/api/google/callback
