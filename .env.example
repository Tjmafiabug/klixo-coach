# KLiXO Coach — environment (one deployment = one centre)

# Google Sheet that backs THIS centre (the invisible DB).
SHEET_ID=

# Service-account credentials with editor access to the Sheet.
# Paste the FULL service-account JSON as a single-line string.
# On Vercel: add as an Encrypted env var. Never commit the real value.
GOOGLE_SERVICE_ACCOUNT_JSON=

# Signing key for the session cookie (HS256 JWT). REQUIRED — auth.ts throws on
# every session read without it, so an unset value is a total outage, not a
# degraded mode. Generate with: openssl rand -base64 32
SESSION_SECRET=

# Centre's local timezone. CRITICAL: "today"/day-of-week is computed here,
# never the server's UTC clock. (See PLAN.md §11.)
CENTER_TZ=Asia/Kolkata

# Bearer token for GET /api/cron/generate (daily session generation).
# Must match the Authorization header Vercel Cron sends. The route fails CLOSED
# when this is unset — it 401s everyone and generation silently stops, so an
# empty value here means no timetable is ever generated.
CRON_SECRET=

# Demo deployments only. Set to 1 to publish the demo PIN on the landing page
# and enable the mock "pay now" button, which credits the fee ledger WITHOUT
# taking any money. Leave unset on a real centre — both are gated server-side
# and fail closed, so a real deployment is safe by default.
DEMO_MODE=
